    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "run_config_schema_version": {
      "const": "1.0",
      "title": "Run Config Schema Version",
      "type": "string"
    },
    "run_mode": {
      "$ref": "#/$defs/RunMode"
    },
    "run_type": {
      "$ref": "#/$defs/RunType"
    },
    "scenario_bank_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Bank Id"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "soc_year_boundary_mode": {
      "$ref": "#/$defs/SocYearBoundaryMode"
    },
    "source_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Run Id"
    },
    "storage_soc_initialization_mode": {
      "$ref": "#/$defs/StorageSocInitializationMode"
    },
    "weather_year_weight_set_id": {
      "title": "Weather Year Weight Set Id",
      "type": "string"
    }
  },
  "required": [
    "run_config_schema_version",
    "run_mode",
    "run_type",
    "method_profile",
    "primary_risk_metric",
    "weather_year_weight_set_id",
    "chronology_mode",
    "storage_soc_initialization_mode",
    "soc_year_boundary_mode",
    "capacity_value_type",
    "allocation_type",
    "random_seed"
  ],
  "title": "run-config-1.0.json",
  "type": "object",
  "x-contract-version": "1.0"
}
