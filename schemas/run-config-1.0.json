        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalization Basis Mwh Per Mw"
    },
    "parent_run_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Parent Run Ids",
      "type": "array"
    },
    "perturbation_dimension": {
      "anyOf": [
        {
