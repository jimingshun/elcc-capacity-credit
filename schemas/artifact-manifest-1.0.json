{
  "$defs": {
    "ArtifactEntry": {
      "additionalProperties": false,
      "description": "Single artifact record inside the manifest.",
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "producer_service": {
          "title": "Producer Service",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "schema_or_template_version": {
          "title": "Schema Or Template Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "[0-9a-fA-F]{64}",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "relative_path",
        "sha256",
        "media_type",
        "producer_service",
        "schema_or_template_version"
      ],
      "title": "ArtifactEntry",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Artifact types (application service contract V0.2 §7.1).\n\nT19 supplement: ``ANALYSIS_SUMMARY`` registers a portfolio /\nsensitivity coordination artifact (portfolio_summary.json,\npenetration_sequence.json, governance_allocation.json,\nsensitivity_matrix.json) into a formal artifact manifest of a\ncoordination run (run_type=portfolio / sensitivity, which has no\nMethodResult).",
      "enum": [
        "json_result",
        "parquet_result",
        "excel_report",
        "html_report",
        "figure",
        "verify_bundle",
        "rerun_bundle",
        "search_trace",
        "analysis_summary"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ConfidentialityLevel": {
      "description": "Artifact confidentiality (application service contract V0.2 §7.1).",
      "enum": [
        "internal",
        "restricted",
        "public_sanitized"
      ],
      "title": "ConfidentialityLevel",
      "type": "string"
    },
    "RedactionStatus": {
      "description": "Artifact redaction status (application service contract V0.2 §7.1).",
      "enum": [
        "not_required",
        "pending",
        "completed"
      ],
      "title": "RedactionStatus",
      "type": "string"
    }
  },
  "$id": "schemas/artifact-manifest-1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "artifacts"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "not": {
              "contains": {
                "properties": {
                  "artifact_type": {
                    "enum": [
                      "analysis_summary"
                    ]
                  }
                },
                "required": [
                  "artifact_type"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "description": "artifact-manifest 1.0: result-bound manifest (application service\ncontract V0.2 §7.1). ``result_id`` is REQUIRED and non-null, and only\nthe historical 1.0 ArtifactEntry types are allowed (analysis_summary\nand future coordination types are rejected at the model level).",
  "properties": {
    "artifact_manifest_id": {
      "format": "uuid",
      "title": "Artifact Manifest Id",
      "type": "string"
    },
    "artifact_schema_version": {
      "const": "1.0",
      "title": "Artifact Schema Version",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactEntry"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "confidentiality_level": {
      "$ref": "#/$defs/ConfidentialityLevel"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generated_by": {
      "title": "Generated By",
      "type": "string"
    },
    "redaction_status": {
      "$ref": "#/$defs/RedactionStatus"
    },
    "report_mapping_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Report Mapping Version",
      "type": "string"
    },
    "result_id": {
      "format": "uuid",
      "title": "Result Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "source_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Run Id"
    }
  },
  "required": [
    "artifact_schema_version",
    "artifact_manifest_id",
    "run_id",
    "result_id",
    "report_mapping_version",
    "confidentiality_level",
    "redaction_status",
    "generated_by",
    "generated_at"
  ],
  "title": "artifact-manifest-1.0.json",
  "type": "object",
  "x-contract-version": "1.0"
}
